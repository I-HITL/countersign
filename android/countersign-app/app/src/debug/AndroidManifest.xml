<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the debug build only. Lets the app talk to a locally-run
  dev server over plain HTTP (Android blocks cleartext traffic by default
  since API 28). The release manifest has no equivalent, so release builds
  stay HTTPS-only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
