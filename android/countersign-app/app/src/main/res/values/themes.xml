<resources>
    <style name="Theme.Countersign" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/cs_primary</item>
        <item name="colorPrimaryVariant">@color/cs_primary</item>
        <item name="colorOnPrimary">@color/cs_on_primary</item>
        <item name="colorSecondary">@color/cs_primary</item>
        <item name="colorOnSecondary">@color/cs_on_primary</item>
        <item name="colorSurface">@color/cs_surface</item>
        <item name="colorOnSurface">@color/cs_text</item>
        <item name="colorError">@color/cs_error</item>
        <item name="android:colorBackground">@color/cs_background</item>
        <item name="android:windowBackground">@color/cs_background</item>
        <item name="android:textColorPrimary">@color/cs_text</item>
        <item name="android:textColorSecondary">@color/cs_text_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/cs_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/cs_light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="materialButtonStyle">@style/Widget.Countersign.Button</item>
    </style>
    <style name="TextAppearance.Countersign.Heading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/cs_text</item>
    </style>
    <style name="TextAppearance.Countersign.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/cs_text_secondary</item>
    </style>
    <style name="Widget.Countersign.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="backgroundTint">@color/button_background</item>
        <item name="iconTint">@color/button_text</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Countersign.Button.Secondary" parent="Widget.Countersign.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/secondary_button_text</item>
        <item name="iconTint">@color/secondary_button_text</item>
        <item name="strokeColor">@color/cs_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/cs_ripple</item>
    </style>
    <style name="Widget.Countersign.Button.Decline" parent="Widget.Countersign.Button.Secondary">
        <item name="android:textColor">@color/decline_button_text</item>
        <item name="iconTint">@color/decline_button_text</item>
    </style>
</resources>
