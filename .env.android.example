# Copy to .env for physical Android. See android/countersign-app/README.md.
COUNTERSIGN_ENABLED_PLATFORMS=android
COUNTERSIGN_DEV_MODE=0
COUNTERSIGN_SKIP_ATTESTATION=0
COUNTERSIGN_SKIP_INTEGRITY=0
COUNTERSIGN_API_TOKEN=
COUNTERSIGN_ADMIN_API_TOKEN=
COUNTERSIGN_DB_PATH=countersign.db

COUNTERSIGN_PACKAGE_NAME=com.countersign.app
# URL-safe Base64 SHA-256 of the Play app-signing certificate (not colon-hex).
COUNTERSIGN_APP_CERT_SHA256=
COUNTERSIGN_ATTESTATION_ROOTS_PATH=attestation_roots/google_hardware_attestation_roots.pem
GOOGLE_APPLICATION_CREDENTIALS=secrets/play-integrity-service-account.json
# Play Integrity device verdicts to accept (comma-separated). Defaults to strong only,
# which needs a recent security patch; add MEETS_DEVICE_INTEGRITY to relax it for testing.
# COUNTERSIGN_ALLOWED_DEVICE_INTEGRITY=MEETS_STRONG_INTEGRITY
