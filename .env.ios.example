# Copy to .env for a physical iPhone. Fill both tokens and your App ID.
COUNTERSIGN_ENABLED_PLATFORMS=ios
COUNTERSIGN_DEV_MODE=0
COUNTERSIGN_SKIP_ATTESTATION=0
COUNTERSIGN_SKIP_INTEGRITY=0
COUNTERSIGN_API_TOKEN=
COUNTERSIGN_ADMIN_API_TOKEN=
COUNTERSIGN_DB_PATH=countersign.db

# Match the App ID prefix + bundle ID, build number, and App Attest entitlement.
COUNTERSIGN_IOS_APP_ID=YOUR_APP_ID_PREFIX.com.example.countersign
COUNTERSIGN_IOS_BUNDLE_VERSION=1
COUNTERSIGN_IOS_ATTESTATION_ENVIRONMENT=development
COUNTERSIGN_IOS_ATTESTATION_ROOTS_PATH=attestation_roots/apple_app_attestation_root.pem
